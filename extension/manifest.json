{
  "manifest_version": 3,
  "name": "Drupal Block Team Assigner",
  "version": "1.0.0",
  "description": "Assign teams to Drupal blocks from a CSV using URL rules.",
  "action": {
    "default_title": "Open Block Team Assigner dashboard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.ucalgary.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.ucalgary.ca/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
